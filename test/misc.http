@host = http://localhost:5000/api

#### create random users (non-production only) --- count=1..200 (default 50)
POST {{host}}/faker?count=200
Content-Type: application/json


#### update schema
POST {{host}}/migration
Content-Type: application/json

{
  "caste": "Balija - Gavara Naidu",
  "to": "Naidu",
  "subTo": "Balija"
}


#### get static files
GET {{host}}/static/v1/castes.json
